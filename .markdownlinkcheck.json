{
    "timeout": "1m",
    "retryOn429": true,
    "retryCount": 5,
    "aliveStatusCodes": [200, 206],
    "ignorePatterns": [
        {
            "pattern": "^http(s)?://(?!(docs\\.aws\\.amazon\\.com|github.com|(www\\.)?terraform\\.io))"
        },
        {
            "pattern": "^https://github.com/[^/]+/[^/]+/(issues|labels|pull)"
        }
    ],
    "replacementPatterns": [
        {
            "pattern": "^(/docs/(?!providers/aws/))",
            "replacement": "https://terraform.io$1"
        },
        {
            "pattern": "^(?!http(s)?://)(.*)\\.html(#.*)?$",
            "replacement": "$2.md$3"
        },
        {
            "pattern": "^/docs/providers/aws/",
            "replacement": "file:///github/workspace/docs/"
        },
        {
            "pattern": "^file:///github/workspace/docs/data-sources/(cognito_user_pools)\\.md(#.*)?$",
            "replacement": "file:///github/workspace/docs/data-sources/$1.md$2"
        },
        {
            "pattern": "^file:///github/workspace/docs/resources/(cognito_identity_pool|cognito_user_pool|iam_role_policy_attachment|iam_user_policy_attachment|network_interface|ram_principal_association|ram_resource_share|ram_resource_share_accepter)\\.md(#.*)?$",
            "replacement": "file:///github/workspace/docs/resources/$1.md$2"
        }
    ]
}
